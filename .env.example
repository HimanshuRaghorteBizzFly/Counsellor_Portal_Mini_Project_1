# ===================================================================
# Counsellor Portal - Environment Configuration Template
# Duplicate this file to .env and adjust values for your environment.
# NEVER commit the actual .env file with secrets into version control!
# ===================================================================

# Application Server Port
PORT=8080

# Active Spring Profile (e.g. dev, prod, test)
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Connection Details
# Local Docker Compose defaults:
DB_URL=jdbc:mysql://db:3306/counsellor_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=counsellor_user
DB_PASSWORD=counsellor_password

# For external cloud MySQL (e.g. Railway, PlanetScale, Aiven, AWS RDS):
# DB_URL=jdbc:mysql://<cloud-db-host>:<port>/<database>?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=<cloud-db-user>
# DB_PASSWORD=<cloud-db-password>

# Database Connection Pool (HikariCP)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_TIMEOUT=30000

# CORS Allowed Origins (Comma-separated origins for web/API security)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://*.vercel.app

# Docker Compose Specific Database Environment (Used by local db service)
MYSQL_ROOT_PASSWORD=root_secure_password
MYSQL_DATABASE=counsellor_db
MYSQL_USER=counsellor_user
MYSQL_PASSWORD=counsellor_password
MYSQL_LOCAL_PORT=3306

# Vercel / External Edge Gateway Proxy (Target URL of running backend container)
BACKEND_URL=http://localhost:8080
