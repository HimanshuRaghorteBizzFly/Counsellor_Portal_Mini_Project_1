# ===================================================================
# Dockerfile.vercel - Vercel Container Runtime Specification
# Optimized for serverless container execution & fast cold-start
# ===================================================================
FROM maven:3.9.9-eclipse-temurin-17-alpine AS build

WORKDIR /app

# Cache dependencies
COPY pom.xml .
RUN mvn dependency:resolve -B

# Compile and package application
COPY src ./src
RUN mvn clean package -DskipTests -B

# ===================================================================
# Minimal Runtime Stage
# ===================================================================
FROM eclipse-temurin:17-jre-alpine

# Install curl for container health monitoring
RUN apk add --no-cache curl

# Security: non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

WORKDIR /app

COPY --from=build --chown=appuser:appgroup /app/target/*.jar app.jar

USER appuser:appgroup

# Dynamic PORT binding and JVM tuning for serverless/container responsiveness
ENV PORT=8080 \
    SPRING_PROFILES_ACTIVE=prod \
    JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=80.0 -XX:+TieredCompilation -XX:TieredStopAtLevel=1 -Djava.security.egd=file:/dev/./urandom"

EXPOSE 8080

# Health check
HEALTHCHECK --interval=20s --timeout=3s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:${PORT:-8080}/health || exit 1

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -Dserver.port=${PORT:-8080} -jar app.jar"]
